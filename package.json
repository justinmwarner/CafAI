{
  "name": "cafai",
  "private": true,
  "version": "0.1.0",
  "description": "CafAI: a chat-first AI dial-in coach skin for Decaid (Decent Espresso).",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:sim": "vite --mode mock --open \"/?mockDecaid=0\"",
    "demo": "vite --mode mock --port 5175 --strictPort --open \"/?demo=1\"",
    "build": "vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "e2e": "playwright test",
    "smoke:chrome91": "node tools/chrome91/smoke.mjs --dist ../../dist-mock --wait \"document.querySelector('[data-testid=app-ready]')\" --hash \"?mockSpeed=25#/\" --name app",
    "release:zip": "node scripts/release-zip.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run release:zip && npm run e2e",
    "smoke:chrome91:loop": "node tools/chrome91/loop.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/system": "9.4.0",
    "@mui/x-chat": "9.0.0-alpha.18",
    "core-js": "3.50.0",
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uplot": "1.6.32",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
